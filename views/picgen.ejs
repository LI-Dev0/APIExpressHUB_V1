<!DOCTYPE html>
<html lang="en" class="container" style="background-color: lightblue; text-align: center; font-family: 'Trebuchet MS', 'Lucida Grande', sans-serif;">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles/styler.css">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body id="picBody" class="container-fluid text-center bg-dark-subtle">
	<nav class="centered-bg bg-primary-subtle text-success p-3 mb-4 rounded-3">
		<a class="navbar-brand" href="/">Home</a>
		<a class="navbar-brand" href="/jokes">JokeHub</a>
	</nav>
	<div class="picHead">
		<h1><%= title %></h1>		
	</div>
    <h3 style=" display: flex; background-color: gray; width: 100%;"><%= description %></h3>
    <hr>

    <div id="picContainer" class="container" style="display: flex; align-items: center; justify-content: space-evenly; width: 100%;">
        <button id="picButton">FETCH Random Picture</button>
        <h2>Your random pics:</h2>
        <div id="picList" style=" display: flex; flex-wrap: wrap; flex-direction: column-reverse; gap: 4px; justify-content: space-around;">
        </div>
        <h3 id="picSrc" class="outline-info bg-dark"></h3>		
    </div>
    <div class="centered-bg bg-primary-subtle text-success outline p-3 mt-4">
        <p>Thanks for visiting PicGen! Hope you enjoyed your experience =)</p>
    </div>    
<script src="/scripts/pic.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/scripts/app.js"></script>

</body>
<footer class="container-fluid footer text-success outline p-3 mt-4 mb-4 rounded-3">
    <div class="container-fluid row">
        <p>Additional information on request.</p>
        <p>Contact us at: info@axhub.com</p>
        <p>Follow us on social media!</p>
    </div>
    <hr class="bg-primary-subtle">
    <div class="container-fluid row">
        <p>&copy; 2025 PicGen. All rights reserved.</p>
    </div>
</footer>
</html>