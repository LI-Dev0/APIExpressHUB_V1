<!DOCTYPE html>
<html lang="en" class="container-fluid">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/styles/styler.css">
    <link rel="stylesheet" href="/styles/picstyles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body id="picBody" class="container-fluid text-center bg-dark-subtle">
    <nav id="navigationLinks" class="container-sm justify-content-center bg-primary-subtle p-3 mb-4 rounded-3">
        <a class="navbar-brand container" href="/">Home</a>
        <a class="navbar-brand container" href="/jokes">JokeHub</a>
    </nav>
    <div class="container-sm p-3 mb-4 rounded-3 bg-primary-subtle outline">
        <h1 id="routenamepic" class="container-sm text-center justify-content-center p-3 rounded-3 outline   ">
            <%= title %>
        </h1>
        <h3 id="welcomeMessage" class=" container-sm text-center justify-content-center p-3 rounded-3 outline   ">
            <%= description %>
        </h3>
    </div>

    <hr>
    <div id="picContainer" class="container-md mt-4 mb-4"
        style="display: flex; align-items: center; justify-content: space-evenly; width: 100%;">
        <button id="picButton"></button>
        <div id="picList" class="callout-info"
            style=" display: grid; grid-template-columns: repeat(2, minmax(200px, 1fr)); gap: 10px;">
        </div>
        <div>
            <h2 class="callout">Fetch Random Pictures using Picsum Photos API!</h2>
        </div>
    </div>
    <div>
        <p class="callout-info">Hit <button></button> to generate random pictures! 👆</p>
        <h3 id="picSrc" class="container callout-success"></h3>
    </div>
    <hr>
    <div id="aipicContainer" class="container-md mt-4 mb-4"
        style="display: flex; align-items: center; justify-content: space-evenly; width: 100%;">
        <div>
            <div id="aipicList" class="container">
            </div>
            <h3 id="aipicSrc" class="container"></h3>
        </div>
        <br>
        <div>
            <h2 class="callout-info">Generate AI Images using Stability API!</h2>
            <button id="promptinfbtn">🛈</button>
            <article id="promptguide"></article>
            <form method="post" id="aipicForm"
                style="display: flex; flex-direction: column; gap: 10px; margin-top: 30px;">
                <div
                    style="display: flex; flex-direction: row; gap: 5px; align-items: center; justify-content: space-around;">
                    <label for="aipicInput">Prompt :</label>
                    <textarea type="text" id="aipicInput"
                        placeholder="Enter as detailed a description for a fulfilling result"
                        style="display: inline-flex; flex-direction: column; align-items: center; justify-content: center;  padding: 5px; border-radius: 4px; border: 1px solid #ccc; width: 500px; height: fit-content; font-family: 'Trebuchet MS', 'Lucida Grande', sans-serif; font-size: 14px; resize: vertical;">
                    </textarea>
                </div>
                <button id="aipicButton"
                    style="padding: 15px; border-radius: 5px; border: none; background-color: #231b537e; color: white; cursor: pointer;">Generate
                    AI Image</button>
            </form>
        </div>
    </div>
    <!-- Help me recreate this block for a different aipicContainer that would render generations using leonarado ai API instead of Stability API. The form should have the same structure but with different ids and the button should have a different id as well. The heading should also be different to reflect the change in API. -->
    <div id="aipicContainer" class="container-md mt-4 mb-4"
        style="display: flex; align-items: center; justify-content: space-evenly; width: 100%;">
        <div class="container">
            <div id="aipicListLeo" class="container">
            </div>
            <h3 id="aipicSrcLeo" class="container"></h3>
        </div>
        <br>
        <div>
            <h2 class="callout-info">Generate AI Images using Leonardo AI API!</h2>
            <button id="promptinfbtnLeo">🛈</button>
            <article id="promptguideLeo"></article>
            <form id="aipicFormLeo" style="display: flex; flex-direction: column; gap: 10px; margin-top: 30px;">
                <div
                    style="display: flex; flex-direction: row; gap: 5px; align-items: center; justify-content: space-around;">
                    <label for="aipicInputLeo">Prompt :</label>
                    <textarea type="text" id="aipicInputLeo"
                        placeholder="Enter as detailed a description for a fulfilling result"
                        style="display: inline-flex; flex-direction: column; align-items: center; justify-content: center;  padding: 5px; border-radius: 4px; border: 1px solid #ccc; width: 500px; height: fit-content; font-family: 'Trebuchet MS', 'Lucida Grande', sans-serif; font-size: 14px; resize: vertical;">
                    </textarea>
                </div>
                <button id="aipicButtonLeo"
                    style="padding: 15px; border-radius: 5px; border: none; background-color: #231b537e; color: white; cursor: pointer;">Generate
                    AI Image</button>
            </form>
        </div>
    </div>
    <div id="endpic" class="centered-bg outline p-3 mt-4 mb-4 rounded-3">
        <p>Thanks for visiting PicHub! Hope you enjoyed your experience =)</p>
    </div>
    <footer class="container flex flex-wrap p-3 mt-4 mb-0 rounded-3 bg-primary-subtle text-dark">

        <div class="container-fluid flex text-center p-3 justify-content-center d-flex gap-5">
            <div id="footercontact" class="container-sm d-flex border p-3 rounded-2 boxshadow-dark boxshadow-hover">
                <p style="font-size: larger; font-weight: 900;">Contact me for any queries or feedback!</p>
                <p> 📞 : <a href="callto:+491788728575">+1234567890</a></p>
                <p> 📧 : <a href="mailto:devliops@outlook.com">devliops@outlook.com</a></p>
            </div>
            <div id="footerlinks" class="container-sm d-flex p-3 rounded-2">
                <p style="font-size: larger; font-weight: 800;">Keep up with me at the following endpoints! 🔍</p>
                <ul>
                    <a href="https://www.linkedin.com/in/lio-ilu-93/"><img
                            src="https://img.icons8.com/nolan/40/linkedin.png" alt="linkedin" /></a>
                    <a href="https://x.com/IluDev93"><img src="https://img.icons8.com/nolan/40/twitterx.png"
                            alt="x" /></a>
                    <a href="https://github.com/LIGunna93"><img src="https://img.icons8.com/nolan/40/github.png"
                            alt="github" /></a>
                </ul>
            </div>

        </div>
        <hr class="container-fluid border-primary-subtle">
        <section id="footerfootpic" class="container-fluid">
            <p style="display: inline-flex;">&copy; <%= new Date().getFullYear() %> APIExpressHub</p>
            <p style="display: inline-flex;"><a href="/policy">Privacy Policy</a></p>
            <h6 style="display: inline-flex;">A design by <em>DevLI</em> of LI Dev</h6>
        </section>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/scripts/pic.js"></script>
</body>

</html>