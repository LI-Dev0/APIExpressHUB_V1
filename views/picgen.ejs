    <h3 style=" display: flex; font-family: 'Roboto', monospace;" class=" container-fluid text-center text-success bg-dark justify-content-center"><%= description %></h3>
    <hr>

    <div id="picContainer" class="container-md" style="display: flex; align-items: center; justify-content: space-evenly; width: 100%;">
        <button id="picButton">FETCH!</button>
        <div id="picList" class="callout-info" style=" display: grid; grid-template-columns: repeat(2, minmax(200px, 1fr)); gap: 10px;">
        </div>      
        <h2>Your random pics:</h2>
        <h3 id="picSrc" class="container callout-info"></h3>
    </div>
    <div>
