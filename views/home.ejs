<!DOCTYPE html>
<html lang="en" class="container-fluid m-0"
    style="background-image: url('https://picsum.photos/id/57/1920/1080'); background-position: bottom; background-color: bisque; background-repeat: no-repeat; background-size: cover; background-attachment: fixed;">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <meta name="description"
        content="APIExpressHub - Your hub for AI-generated art and developer humor. Generate images and enjoy jokes through our interactive APIs.">
    <link rel="stylesheet" href="/styles/styler.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body class="container flex bg-dark border border-dark backdrop-blur rounded-3">
    <!-- Main Header -->
    <div class="container-fluid">
        <h1 class="gradient-title mt-4">
            <span aria-label="robot" role="img">🤖</span>
            APIExpressHub
            <span aria-label="rocket" role="img">🚀</span>
        </h1>
        <p class="tagline">Your Hub for AI-Generated Art & Developer Humor.</p>
    </div>

    <!-- Hero Section - Live Preview -->
    <section class="hero-section">
        <!-- Joke Preview Panel -->
        <div class="hero-panel hero-panel-joke">
            <h3>🎭 Live Joke Preview</h3>
            <div id="hero-joke-preview">
                <p style="text-align: center; padding: 40px; color: #81f59a;">
                    Loading a joke for you...
                </p>
            </div>
            <button id="hero-joke-btn" class="mt-3">🔄 Get Another</button>
        </div>

        <!-- Image Showcase Panel -->
        <div class="hero-panel hero-panel-pic">
            <h3>🎨 AI Art Showcase</h3>
            <p style="color: bisque; font-size: 1.1rem; margin-bottom: 20px;">
                Generate stunning AI images with simple prompts
            </p>
            <div class="hero-pic-gallery">
                <img src="https://picsum.photos/id/237/300/300" alt="AI Generated Art Sample 1" loading="lazy">
                <img src="https://picsum.photos/id/1015/300/300" alt="AI Generated Art Sample 2" loading="lazy">
                <img src="https://picsum.photos/id/1018/300/300" alt="AI Generated Art Sample 3" loading="lazy">
                <img src="https://picsum.photos/id/1025/300/300" alt="AI Generated Art Sample 4" loading="lazy">
            </div>
        </div>
    </section>

    <!-- Getting Started Tips -->
    <section class="container-sm p-4 mt-5 mb-4 rounded-3 bg-primary-subtle" style="border: 2px solid #81f59a;">
        <h3 class="text-center mb-3" style="color: var(--primary-dark);">💡 Quick Start Guide</h3>
        <ul style="color: var(--primary-dark); font-size: 1.1rem; line-height: 1.8;">
            <li><strong>Try it now:</strong> Click "Get Another" above to fetch a new joke instantly</li>
            <li><strong>Explore APIs:</strong> Navigate to JokeHub or PicHub using the feature cards</li>
            <li><strong>For Developers:</strong> Check out the <a href="https://github.com/LIGunna93/APIExpressHUB"
                    class="text-decoration-none" style="color: var(--pic-accent); font-weight: 600;">GitHub repo</a> for
                API documentation</li>
            <li><strong>Rate Limits:</strong> Fair usage limits ensure quality service for everyone</li>
        </ul>
    </section>

    <!-- Features Section -->
    <section class="features-section fade-in-up">
        <h2 class="text-center" style="font-size: 2.5rem; color: azure; margin-bottom: 20px;">
            🌟 Explore Our Features
        </h2>
        <p class="text-center" style="font-size: 1.2rem; color: #a6d2e4; margin-bottom: 40px;">
            Two powerful APIs, infinite possibilities
        </p>

        <div class="features-grid">
            <!-- JokeHub Feature Card -->
            <div class="feature-card feature-card-joke">
                <span class="feature-card-icon">🎭</span>
                <h3>JokeHub</h3>
                <p>
                    Get your daily dose of laughter! Access thousands of dad jokes and legendary Chuck Norris humor.
                    Perfect for brightening your day or adding fun to your projects.
                </p>
                <ul style="color: #c8e3ed; margin-bottom: 20px; line-height: 1.8;">
                    <li>✨ Dad Jokes API - Family-friendly humor</li>
                    <li>💪 Chuck Norris Jokes - Legendary quips</li>
                    <li>🔄 Instant refresh - Never run out of laughs</li>
                    <li>📱 Mobile-optimized - Jokes on the go</li>
                </ul>
                <a href="/jokes" class="cta-button">Start Laughing →</a>
            </div>

            <!-- PicHub Feature Card -->
            <div class="feature-card feature-card-pic">
                <span class="feature-card-icon">🎨</span>
                <h3>PicHub</h3>
                <p>
                    Transform your imagination into visual art! Generate stunning AI images from text prompts using
                    cutting-edge Stability AI and Leonardo AI technology.
                </p>
                <ul style="color: #c8e3ed; margin-bottom: 20px; line-height: 1.8;">
                    <li>🖼️ Multiple AI engines - Compare results</li>
                    <li>⚡ Lightning-fast generation - See ideas come alive</li>
                    <li>🎯 Detailed prompts - Full creative control</li>
                    <li>💾 Random inspiration - Picsum integration</li>
                </ul>
                <a href="/pichub" class="cta-button">Generate Art →</a>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section id="stats-section" class="fade-in-up">
        <h2 class="text-center" style="font-size: 2.5rem; color: azure; margin-bottom: 40px;">
            📊 Powered by Community
        </h2>
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-icon">🎭</div>
                <span class="stat-number" data-target="1000">0</span>
                <div class="stat-label">Jokes Delivered</div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">🎨</div>
                <span class="stat-number" data-target="100">0</span>
                <div class="stat-label">Images Generated</div>
            </div>
            <div class="stat-item">
                <div class="stat-icon">⚡</div>
                <span class="stat-number" data-target="99">0</span>
                <div class="stat-label">% Uptime</div>
            </div>
        </div>
    </section>


    <hr class="container-fluid border-dark mt-5">

    <!-- Footer -->
    <footer class="container-lg flex p-3 mt-4 mb-0 rounded-3 bg-primary-subtle text-dark">
        <div class="container-fluid flex text-center p-3 justify-content-center d-flex gap-5">
            <div id="footercontact" class="container-sm d-flex border p-3 rounded-2 boxshadow-dark boxshadow-hover">
                <p>💬</p>
                <p style="font-size: larger; font-weight: 900;">Contact for queries or feedback!</p>
                <p>📞: <a href="callto:+491788728575">+1234567890</a></p>
                <p>📧: <a href="mailto:devliops@outlook.com">devliops@outlook.com</a></p>
            </div>
            <div id="footerlinks" class="container-sm d-flex p-3 rounded-2">
                <p>🖲</p>
                <p style="font-size: larger; font-weight: 900;">Connect with me!</p>
                <ul style="background-color: transparent;">
                    <a href="https://www.linkedin.com/in/lio-ilu-93/" aria-label="LinkedIn"><img
                            src="https://img.icons8.com/nolan/40/linkedin.png" alt="LinkedIn" /></a>
                    <a href="https://x.com/IluDev93" aria-label="Twitter/X"><img
                            src="https://img.icons8.com/nolan/40/twitterx.png" alt="Twitter/X" /></a>
                    <a href="https://github.com/LIGunna93" aria-label="GitHub"><img
                            src="https://img.icons8.com/nolan/40/github.png" alt="GitHub" /></a>
                </ul>
            </div>
        </div>
        <hr class="container-fluid border-dark">
        <section class="container-fluid d-flex justify-content-between align-items-center flex-wrap">
            <p style="margin: 5px;">&copy; 2025 APIExpressHub</p>
            <p style="margin: 5px;"><a href="/policy" style="text-decoration: none; color: inherit;">Privacy Policy</a>
            </p>
            <h6 style="margin: 5px;">A design by <em>DevLI</em> of LI Dev</h6>
        </section>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="/scripts/home.js"></script>
</body>

</html>