<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>JokeHub</h1>
    <ul>
        <% jokes.forEach(function(joke) { %>
            <li><%= joke %></li> <!-- This escapes HTML by default, safe for untrusted content -->
        <% }); %>
    </ul>
</body>

<script src="jokes.js"></script>
</html>