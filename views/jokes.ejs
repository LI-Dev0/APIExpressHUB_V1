<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    
    <h1>JokeHub</h1>
<!--
    <ul>
        <% jokes.forEach(function(joke) { %> -->
        <!-- <li><%= joke %></li> -->   <!-- This escapes HTML by default, safe for untrusted content -->
<!--        <% }); %>
    </ul>  -->
    <div id="jokes"></div>
    <script>
    axios.get("https://official-joke-api.appspot.com/jokes/ten")
        .then(response => {
        const jokes = response.data.map(joke => joke.setup + " " + joke.punchline);
        document.getElementById("jokes").innerHTML = jokes.join("<br>");
        })
        .catch(error => {
        document.getElementById("jokes").innerHTML = "Failed to load jokes.";
        console.error("Error fetching jokes:", error);
        });
    </script>
</body>

<script src="jokes.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</html>